# Aipply Backend Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# OpenAI API Key (required for LLM and Vision features)
OPENAI_API_KEY=your-openai-api-key

# Search Provider: chromadb (local) or opensearch (AWS)
SEARCH_PROVIDER=chromadb

# LLM Provider: openai, gemini, or bedrock
LLM_PROVIDER=openai

# ChromaDB Configuration (if using chromadb)
CHROMADB_DATA_DIR=./data/chroma_data
CHROMADB_COLLECTION_NAME=document_chunks

# OpenAI Model Configuration (if using openai)
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Google Gemini Configuration (if using gemini)
# GOOGLE_API_KEY=your-google-api-key
# GEMINI_MODEL=gemini-1.5-flash

# AWS Configuration (required - used for S3 uploads and DynamoDB regardless
# of SEARCH_PROVIDER/LLM_PROVIDER; also required if using bedrock/opensearch)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Configuration (file uploads)
S3_BUCKET_NAME=your-bucket-name

# Auth token signing secret - MUST be set to a real random value in
# production. Falls back to an insecure hardcoded value if unset.
JWT_SECRET_KEY=change-me-to-a-random-secret

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to https://aipply1.com if unset.
CORS_ORIGINS=https://your-frontend-domain.vercel.app
