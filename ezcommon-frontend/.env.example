# Aipply Frontend Configuration
# Copy this file to .env.local for local dev, or set these in your hosting
# platform's dashboard (e.g. Vercel Project Settings > Environment Variables)
# for production.

# Points the /api/backend/* proxy at the real Python backend. If unset, every
# request is served from an in-memory demo mock instead (see
# app/api/backend/[...path]/route.ts) - this MUST be set in production or
# the app will silently serve fake data.
BACKEND_URL=https://your-backend.onrender.com

# NextAuth session encryption - MUST be a real random value in production.
# Falls back to an insecure hardcoded value if unset. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-secret

# The canonical URL this app is deployed at (required by NextAuth in prod).
NEXTAUTH_URL=https://your-frontend.vercel.app

# Optional: only set this if you want the browser to call the backend
# directly instead of through the same-origin /api/backend proxy above.
# Leaving it unset is simpler and avoids needing backend CORS for browser
# traffic entirely.
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Optional: enables "Sign in with Google" - omit to keep credentials-only auth.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
