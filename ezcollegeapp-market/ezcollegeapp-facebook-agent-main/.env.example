# OpenAI
OPENAI_API_KEY=sk-...

# Google Gemini (alternative LLM provider)
GEMINI_API_KEY=...

# Agent behavior
DRY_RUN=true          # true = never post, just print
LLM_PROVIDER=openai   # openai | gemini

# Facebook login is done manually in the browser on first run.
# No credentials needed here — the session is saved to memory/fb_browser_data/.

# Browser
PLAYWRIGHT_HEADLESS=0   # 0 = headed (default, required for first login); 1 = headless (server mode, requires saved session)

# ---------------------------------------------------------------
# Live browser tests — set LIVE_BROWSER_TEST=1 to enable
# ---------------------------------------------------------------
LIVE_BROWSER_TEST=1

# Publish a post
TEST_FB_POST_CAPTION=This is a test post
TEST_FB_POST_MEDIA=                        # optional: path to image, e.g. ./assets/photo.jpg

# Comment under a post
TEST_FB_COMMENT_URL=https://www.facebook.com/permalink/123456789/
TEST_FB_COMMENT_TEXT=Great post!

# Reply to a comment
TEST_FB_REPLY_URL=https://www.facebook.com/permalink/123456789/
TEST_FB_REPLY_TEXT=Thanks for sharing!
TEST_FB_REPLY_COMMENT_INDEX=0              # 0 = first comment, 1 = second, etc.

# Follow / Add Friend
TEST_FB_FOLLOW_TARGET=page.slug.here       # part after facebook.com/ in the profile URL
